        "stacked": false,
        "region": "ap-northeast-2",
        "period": 60,
        "metrics": [
          [
            {
              "expression": "REMOVE_EMPTY(SEARCH('{PetClinic/WAS,AutoScalingGroupName,InstanceId} MetricName=\"mem_used_percent\"', 'Average', 60))",
